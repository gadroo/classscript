{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@curriculum/schemas": ["packages/schemas/src/index.ts"],
      "@curriculum/prompts": ["packages/prompts/src/index.ts"],
      "@curriculum/rendering": ["packages/rendering/src/index.ts"]
    }
  }
}
